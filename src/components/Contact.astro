---
import ContactMethods from './ContactMethods.astro';
---
<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="head">
      <p class="eyebrow reveal"><span>05</span> Contact</p>
      <h2 id="contact-title" class="section-title reveal" style="--d:60ms">Let’s <span class="gradient-text">get in touch</span></h2>
      <p class="section-intro reveal" style="--d:120ms">Pick whichever way suits you best. I’d love to hear from you.</p>
    </div>

    <div class="contact-options">
      <ContactMethods />
    </div>
  </div>
</section>

<style>
  .contact { position: relative; background: radial-gradient(900px 400px at 85% 0%, rgba(112, 72, 232, 0.16), transparent 70%), var(--bg); }
  .contact-options { margin-top: 2.5rem; }
</style>
