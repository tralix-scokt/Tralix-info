---
import { contact, links, hasPhone } from '../config/site';
import Icon from './Icon.astro';

const methods = [
  // "Call Me" only appears if a phone number is set in src/config/site.ts
  ...(hasPhone ? [{ label: 'Call Me', value: contact.phone.display || contact.phone.number, href: links.tel, icon: 'phone', external: false }] : []),
  { label: 'WhatsApp', value: contact.whatsapp.display, href: links.whatsapp, icon: 'whatsapp', external: true },
  { label: 'Email Me', value: contact.email.address, href: links.mailto, icon: 'mail', external: false },
];
---
<ul class="methods">
  {methods.map((m, i) => (
    <li class="reveal" style={`--d:${i * 70}ms`}>
      <a
        class="method"
        href={m.href}
        {...(m.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        <span class="ico"><Icon name={m.icon} size={24} /></span>
        <span class="txt">
          <span class="lbl">{m.label}{m.external && <span class="visually-hidden"> (opens in a new tab)</span>}</span>
          <span class="val">{m.value}</span>
        </span>
        <span class="arrow" aria-hidden="true"><Icon name="arrow-up-right" size={20} /></span>
      </a>
    </li>
  ))}
</ul>

<style>
  .methods { display: grid; gap: 0.85rem; }
  .method {
    display: flex; align-items: center; gap: 1rem; padding: 1rem 1.2rem; min-height: 76px;
    text-decoration: none; border-radius: var(--radius);
    background: linear-gradient(160deg, var(--surface-2), var(--surface)); border: 1px solid var(--border);
    transition: transform 0.3s var(--ease), border-color 0.3s, box-shadow 0.3s var(--ease);
  }
  .method:hover { transform: translateY(-3px); border-color: var(--blue); box-shadow: 0 18px 40px -26px rgba(106, 165, 255, 0.7); }
  .ico {
    flex: none; display: grid; place-items: center; width: 50px; height: 50px; border-radius: 14px;
    background: var(--grad); color: #0a0c18;
  }
  .txt { display: grid; min-width: 0; flex: 1; }
  .lbl { font-weight: 800; font-size: 1.05rem; }
  .val { color: var(--muted); font-size: 0.97rem; overflow-wrap: anywhere; }
  .arrow { color: var(--muted); transition: transform 0.3s var(--ease), color 0.2s; }
  .method:hover .arrow { transform: translate(3px, -3px); color: var(--text); }
</style>
