---
import { profile, contact, links, nav } from '../config/site';
import SocialLinks from './SocialLinks.astro';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container top">
    <div class="about">
      <p class="name">{profile.name}</p>
      <p class="desc">{profile.title}. {profile.shortBio}</p>
      <SocialLinks variant="icons" label="Social media links" />
    </div>

    <nav aria-label="Footer">
      <h2>Explore</h2>
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2>Contact</h2>
      <ul>
        <li><a href={links.tel}>{contact.phone.display}</a></li>
        <li><a href={links.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp<span class="visually-hidden"> (opens in a new tab)</span></a></li>
        <li><a href={links.mailto}>{contact.email.address}</a></li>
      </ul>
    </div>
  </div>

  <div class="container bottom">
    <p>© {year} {profile.name}. All rights reserved.</p>
    <p>Built by {profile.name}</p>
  </div>
</footer>

<style>
  .footer { background: #070913; border-top: 1px solid var(--border); padding-top: 3.5rem; }
  .top { display: grid; gap: 2.5rem; }
  .name { font-size: 1.35rem; font-weight: 800; letter-spacing: -0.01em; }
  .desc { color: var(--muted); margin: 0.5rem 0 1.2rem; max-width: 46ch; font-size: 1rem; }
  h2 { font-size: 0.85rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue); margin-bottom: 0.8rem; }
  li a { display: inline-block; padding: 0.3rem 0; color: var(--muted); text-decoration: none; overflow-wrap: anywhere; transition: color 0.2s; }
  li a:hover { color: var(--text); text-decoration: underline; text-underline-offset: 4px; }
  .bottom {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1.5rem;
    margin-top: 2.5rem; padding-block: 1.5rem; border-top: 1px solid var(--border); color: var(--muted); font-size: 0.95rem;
  }
  @media (min-width: 820px) { .top { grid-template-columns: 1.6fr 1fr 1fr; gap: 3rem; } }
</style>
