---
import { brandIcons, uiIcons } from '../config/icons';
interface Props { name: string; size?: number; class?: string; }
const { name, size = 22, class: className } = Astro.props;
const brand = brandIcons[name];
const ui = uiIcons[name] ?? uiIcons.link;
---
{brand ? (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d={brand} /></svg>
) : (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={ui} /></svg>
)}
