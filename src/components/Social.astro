---
import { socials, socialSection } from '../config/site';
import Icon from './Icon.astro';
---
<section id="social" class="section social" aria-labelledby="social-title">
  <div class="container">
    <div class="head">
      <p class="eyebrow reveal"><span>04</span> Social</p>
      <h2 id="social-title" class="section-title reveal" style="--d:60ms">{socialSection.heading}</h2>
      <p class="section-intro reveal" style="--d:120ms">{socialSection.intro}</p>
    </div>
    <ul class="list">
      {socials.map((s, i) => (
        <li class="reveal" style={`--d:${i * 70}ms`}>
          <a class="item" href={s.url} target="_blank" rel="noopener noreferrer">
            <span class="ico"><Icon name={s.icon} size={28} /></span>
            <span class="txt">
              <span class="lbl">{s.label}<span class="visually-hidden"> (opens in a new tab)</span></span>
              <span class="handle">{s.handle}</span>
              {s.blurb && <span class="blurb">{s.blurb}</span>}
            </span>
            <span class="arrow" aria-hidden="true"><Icon name="arrow-up-right" size={20} /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .social { background: var(--bg-soft); }
  .list { display: grid; gap: 1rem; margin-top: 2.25rem; }
  .item {
    position: relative; display: flex; align-items: center; gap: 1rem; padding: 1.25rem 1.3rem; min-height: 92px;
    text-decoration: none; border-radius: var(--radius); overflow: hidden;
    background: linear-gradient(160deg, var(--surface-2), var(--surface)); border: 1px solid var(--border);
    transition: transform 0.3s var(--ease), border-color 0.3s, box-shadow 0.3s var(--ease);
  }
  .item::before {
    content: ''; position: absolute; inset: 0; background: var(--grad); opacity: 0; transition: opacity 0.3s;
  }
  .item:hover { transform: translateY(-4px); border-color: var(--blue); box-shadow: 0 22px 44px -26px rgba(122, 140, 255, 0.8); }
  .item:hover::before { opacity: 0.08; }
  .ico, .txt, .arrow { position: relative; }
  .ico {
    flex: none; display: grid; place-items: center; width: 58px; height: 58px; border-radius: 16px;
    background: rgba(255,255,255,0.05); border: 1px solid var(--border-strong); color: var(--text);
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }
  .item:hover .ico { background: var(--grad); color: #0a0c18; border-color: transparent; }
  .txt { display: grid; min-width: 0; flex: 1; }
  .lbl { font-weight: 800; font-size: 1.15rem; }
  .handle { color: #cfd6ff; font-size: 0.97rem; overflow-wrap: anywhere; }
  .blurb { color: var(--muted); font-size: 0.9rem; }
  .arrow { color: var(--muted); transition: transform 0.3s var(--ease), color 0.2s; }
  .item:hover .arrow { transform: translate(3px, -3px); color: var(--text); }
  @media (min-width: 760px) { .list { grid-template-columns: repeat(2, minmax(0, 1fr)); } .item { flex-direction: column; align-items: flex-start; padding: 1.6rem; gap: 1.1rem; } .arrow { position: absolute; top: 1.3rem; right: 1.3rem; } }
  @media (min-width: 1020px) { .list { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
