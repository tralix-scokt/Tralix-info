---
import '../styles/global.css';
import { site, pageTitle, profile } from '../config/site';

// Canonical + share-image URLs must be absolute, so they are only added once site.url is set.
const canonical = site.url ? new URL(Astro.url.pathname, site.url).href : '';
const ogImage = site.url ? new URL(site.ogImage, site.url).href : '';
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content={site.themeColor} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={site.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={site.description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Lets CSS know JS is available (so scroll-reveal never hides content without JS) -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
